# Copie para .env.development ou .env.production apenas se ainda não existir.
# Nunca envie senhas pelo chat. Também são aceitas as variáveis MAIL_SYSTEM_*.
PORT=3100
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Origem HTTPS pública, sem caminho. Vazio bloqueia envio real.
UNSUBSCRIBE_BASE_URL=
# Serviço de descadastro separado do painel; use proxy reverso HTTPS.
UNSUBSCRIBE_PORT=3101

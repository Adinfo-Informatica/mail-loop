# Copie para .env.development ou .env.production apenas se ainda não existir.
# Nunca envie senhas pelo chat. Também são aceitas as variáveis MAIL_SYSTEM_*.
PORT=3100
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Origem HTTPS pública, sem caminho. Vazio bloqueia envio real.
UNSUBSCRIBE_BASE_URL=
# Porta auxiliar local; o HTTPS principal tambem atende /unsubscribe/TOKEN.
UNSUBSCRIBE_PORT=3101

# Acesso MailLoop: cadastre a conta com npm run setup:admin -- --env=development
HOST=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
TLS_CERT_FILE=
TLS_KEY_FILE=
